# Publishing the block-race observation. Installed to /etc/xl1/publish-race.env;
# run by systemd/xl1-race-publish.timer every 15 minutes.
# Same repository and credential as publish.env; only the source, the file name
# and the working copy differ. Set FILE to race-<network>.json.
XL1_PUBLISH_REPO=git@github.com:LewSales/xl1-status-data.git
XL1_PUBLISH_BRANCH=main
XL1_PUBLISH_PATH=.
XL1_PUBLISH_URL=http://127.0.0.1:8097/race.json
XL1_PUBLISH_FILE=race-mainnet.json
XL1_PUBLISH_PAGE=
XL1_PUBLISH_WORKDIR=/var/lib/xl1-publish-race
XL1_PUBLISH_GIT_NAME=xl1-publisher
XL1_PUBLISH_GIT_EMAIL=xl1-publisher@users.noreply.github.com
