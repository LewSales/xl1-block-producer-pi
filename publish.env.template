# Publishing this node's public status page. Installed to /etc/xl1/publish.env.
#
# The page is public; the repository it lives in is private, so nobody but you
# can change what it says.
#
# What gets published is decided by the dashboard, not by this file: the
# publisher copies /api/public verbatim, and that endpoint is an allow-list.
# A field added to the dashboard later stays unpublished until somebody chooses
# to publish it.

# The repository this page lives in. Vercel is connected to it and a push
# updates the site.
#
# One repository per node, not one shared between them: a bad deploy, a wrong
# credential or a provider outage on one producer is then incapable of touching
# the other's page.
XL1_PUBLISH_REPO=https://github.com/LewSales/xl1-status-rbpi3.git
XL1_PUBLISH_BRANCH=main

# Where inside that repository to write. The root, because the repository holds
# exactly one node's page -- set a subdirectory only if you ever point several
# nodes at one repo.
XL1_PUBLISH_PATH=.

# Where the working copy is kept. Shallow, single-branch, and disposable: delete
# it and the next run clones again.
# XL1_PUBLISH_WORKDIR=

# Where to read from. Change only if the dashboard is on another port, or set
# the token if DASH_TOKEN is configured in dashboard.env.
XL1_PUBLISH_URL=http://127.0.0.1:8088/api/public
XL1_PUBLISH_TOKEN=

# Author on the commits this makes. It is a machine, and the history should say
# so rather than borrowing your name for something you did not type.
XL1_PUBLISH_GIT_NAME=xl1-publisher
XL1_PUBLISH_GIT_EMAIL=xl1-publisher@users.noreply.github.com
