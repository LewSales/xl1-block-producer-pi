# XL1 dashboard configuration. Installed to /etc/xl1/dashboard.env.
# No secrets belong in this file — it is world-readable by design.

XL1_NETWORK=sequence
DASH_PORT=8088
DASH_BIND=0.0.0.0

# Balance panel. Set this to the same value as XL1_REWARD_ADDRESS in the
# producer env. A leading 0x is stripped automatically: XL1 balance lookups
# take bare lowercase hex and reject the 0x form.
XL1_REWARD_ADDRESS=

# Optional — the producer's own signing address, if you want its balance shown
# alongside the reward address. This is the address that must appear on the
# network's allowed-producer list for your blocks to be accepted.
XL1_PRODUCER_ADDRESS=

XL1_HEALTH_URL=http://127.0.0.1:9099
XL1_STATUS_FILE=/var/lib/xl1/producer-status.json
DASH_DISK_PATH=/var/lib/xl1

# Optional shared secret. When set, every request needs ?token=... or an
# Authorization: Bearer header. Worth setting if the tailnet is shared.
DASH_TOKEN=

DASH_CHAIN_POLL_MS=15000
DASH_LOCAL_POLL_MS=5000
