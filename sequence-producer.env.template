# XL1 federated producer on the Sequence (beta) network.
# Installed to /etc/xl1/sequence-producer.env with mode 0600 — this file holds
# a wallet seed phrase. Do not copy it off the Pi or commit it anywhere.

XL1_NETWORK=sequence
XL1_ROLE=producer

# REQUIRED — the root wallet phrase this node signs with.
XL1_MNEMONIC=

# REQUIRED — where block rewards are paid.
# Either form works here; the dashboard normalizes it for balance lookups.
XL1_REWARD_ADDRESS=

# Optional overrides. The sequence preset already carries all three, so leave
# them commented unless you are deliberately pointing somewhere else.
# XL1_CHAIN__ID=4b43a753c8024c0e5000e8ac948ac0063ac624bc
# XL1_RPC_URL=https://beta.api.chain.xyo.network/rpc
# XL1_EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

XL1_LOG__LOG_LEVEL=info
XL1_HEALTH_CHECK_PORT=9099
