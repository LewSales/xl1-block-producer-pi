# XL1 dashboard configuration. Installed to /etc/xl1/dashboard.env.
# No secrets belong in this file — it is world-readable by design.

XL1_NETWORK=sequence
DASH_PORT=8088
DASH_BIND=0.0.0.0

# Balance panel. Set this to the same value as XL1_REWARD_ADDRESS in the
# producer env. A leading 0x is stripped automatically: XL1 balance lookups
# take bare lowercase hex and reject the 0x form.
XL1_REWARD_ADDRESS=

# Optional — the producer's own signing address, if you want its balance shown
# alongside the reward address. This is the address that must appear on the
# network's allowed-producer list for your blocks to be accepted.
XL1_PRODUCER_ADDRESS=

# Optional — explorer the dashboard links to. Defaults to
# https://explore.xyo.network/xl1/<XL1_NETWORK>. Address links append
# /address/<bare-hex>, block links /block/number/<height>. Override only for a
# private explorer deployment.
# DASH_EXPLORER_URL=https://explore.xyo.network/xl1/sequence

# Optional — where to look up the newest published CLI, for the "update
# available" comparison against what the container runs. Set empty to switch
# version checking off entirely.
# DASH_CLI_REGISTRY=https://registry.npmjs.org/@xyo-network/xl1-cli/latest

# Long-range history, kept on disk so it survives a container restart. Needs the
# writable bind mount for /var/lib/xl1/dashboard that xl1-dashboard.service sets
# up; leave these alone unless you are short of card space.
#
# Leave commented rather than blank: a blank line is an empty string, not an
# absent one, and would override the default with nothing.
# DASH_TREND_RETAIN_DAYS=30
# DASH_TREND_EVERY_MS=300000
# DASH_TREND_FILE=/var/lib/xl1/dashboard/trend.jsonl

# Producer standings — who else is signing blocks, tallied from the same chain
# scan that counts this node's own. Totals persist across restarts in the same
# writable bind mount as the trend store.
#
# DASH_PEERS_TOP is how many rows the table shows; this node is always shown
# even when it ranks below the cut.
# DASH_PEERS_TOP=12
# DASH_PEERS_EVERY_MS=300000
# DASH_PEERS_FILE=/var/lib/xl1/dashboard/peers.json

# Names for the standings table, so it reads as producers rather than hex.
# Comma-separated address=name. The address may be a full 40-character address
# or a prefix of at least 8 hex characters — a prefix is what a block explorer
# gives you, since every one of them truncates.
#
# A prefix matching two producers is left unlabelled and reported on the page
# rather than guessed at: a wrong name against a row is worse than no name.
#
# New producers need no configuration to appear — the board is built from block
# signers, so an address shows up the moment it signs its first block. Labels
# only decide whether the row reads as a name or as truncated hex.
#
# Labelling your OWN address is worth doing too: the row falls back to "this
# node" only when nothing names it, so a label replaces that with whatever you
# call yourself. Useful the moment there is more than one operator looking at
# the same screenshot. It stays highlighted as yours either way — that comes
# from the address matching, not from the name.
# DASH_PEER_LABELS=a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4=Alice,9f3ac210=Bob

# How far back the very first scan looks, and how many blocks one poll may spend
# catching up after the dashboard has been down. Raising the catch-up makes a
# long outage close faster at the cost of more gateway reads per poll; it never
# skips blocks either way.
# DASH_PRODUCTION_WINDOW=120
# DASH_PRODUCTION_CATCHUP=1000

# The standings split the same blocks into per-day buckets, so the table can
# show today and the last seven days beside the running total. They routinely
# disagree, and that is the point: a node that was offline for two days is a
# long way behind on the total and level with everyone for today.
#
# Blocks are filed by their own $epoch, not by when the dashboard read them, so
# a catch-up after an outage lands on the right days instead of inventing a
# spike on the day it recovered.
#
# DASH_DAY_TZ decides when "today" rolls over. The container runs UTC, so an
# operator in Denver watching an unset value would see the day turn at 18:00
# local. Set it to the zone you actually read the page in.
# DASH_DAY_TZ=America/Denver
#
# How many days of buckets to keep. Five weeks by default, enough to compare
# this week against last.
# DASH_PEERS_DAYS=35

# Which ineligibility complaints count on this network. Comma-separated keys;
# leave blank to use the per-network defaults (on sequence, staking complaints
# are informational because the network does not enforce them).
DASH_ELIGIBILITY_IGNORE=

XL1_HEALTH_URL=http://127.0.0.1:9099
XL1_STATUS_FILE=/var/lib/xl1/producer-status.json
DASH_DISK_PATH=/var/lib/xl1

# Optional shared secret. When set, every request needs ?token=... or an
# Authorization: Bearer header. Worth setting if the tailnet is shared.
DASH_TOKEN=

DASH_CHAIN_POLL_MS=15000
DASH_LOCAL_POLL_MS=5000
