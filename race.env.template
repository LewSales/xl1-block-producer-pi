# The block-race observer (systemd/xl1-race.service). Installed to /etc/xl1/race.env.
#
# Watch the network this producer is on: its own position on the network is part
# of every arrival time, which is why a second observer is worth having.
RACE_NETWORK=mainnet
RACE_PORT=8097
# Gentler than the Windows observer's 500/500/1000: this one shares an uplink with a producer.
RACE_POOL_MS=750
RACE_HEAD_MS=1000
RACE_TX_MS=2000
RACE_WINDOW_H=6
# Arrival order only; this container cannot (and should not) read the producer's logs.
RACE_BUILDLOGS=none
# Step aside when the producer struggles: no polling for 10 minutes while its
# 95th-percentile cycle (from the dashboard) is above this.
RACE_GUARD_URL=http://127.0.0.1:8088/api/public
RACE_GUARD_P95_MS=2500
