[Unit]
Description=Publish the XL1 block-race observation every 15 minutes
Documentation=https://github.com/LewSales/xl1-block-producer-pi

[Timer]
# The race is an aggregate over hours; fifteen minutes is fresh enough and keeps
# the data repository's history small.
OnBootSec=10min
OnUnitActiveSec=15min
RandomizedDelaySec=60
AccuracySec=30s

[Install]
WantedBy=timers.target
