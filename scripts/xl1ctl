#!/usr/bin/env bash
# xl1ctl — one command for operating the producer.
#
#   xl1ctl status              what is running, chain position, balance
#   xl1ctl start | stop | restart
#   xl1ctl logs [-f|-n N]      producer logs
#   xl1ctl health              raw probe + dashboard summary
#   xl1ctl addr                which address the node actually signs as
#   xl1ctl dashboard           print the dashboard URLs
#   xl1ctl backup [FILE]       encrypted backup of /etc/xl1 (contains the seed)
#   xl1ctl restore FILE        restore from one
#   xl1ctl update --release    download the latest release and reload
#   xl1ctl update              reload images from tarballs already on disk
#   xl1ctl versions            producer images kept on this Pi
#   xl1ctl rollback [VERSION]  put the previous image back and restart
#   xl1ctl doctor              diagnose a producer that is not working

set -uo pipefail

CONF_DIR=/etc/xl1
STATE_DIR=/var/lib/xl1
PRODUCER_ENV="${CONF_DIR}/sequence-producer.env"
DASH_ENV="${CONF_DIR}/dashboard.env"
DASH_IMAGE=xl1-dashboard:local

BOLD=$'\033[1m'; DIM=$'\033[2m'; RESET=$'\033[0m'
GREEN=$'\033[32m'; YELLOW=$'\033[33m'; RED=$'\033[31m'; BLUE=$'\033[34m'

die()  { printf '%serror:%s %s\n' "${RED}" "${RESET}" "$*" >&2; exit 1; }
head_() { printf '\n%s%s%s\n' "${BOLD}${BLUE}" "$1" "${RESET}"; }
row()  { printf '  %-22s %s\n' "$1" "$2"; }

need_root() { [[ ${EUID} -eq 0 ]] || die "this needs root — try: sudo xl1ctl $*"; }

dash_port() { grep -oP '^DASH_PORT=\K.*' "${DASH_ENV}" 2>/dev/null || echo 8088; }

# ------------------------------------------------------------------- versions
#
# `update` is the one command here that can take a working node off the chain,
# and it used to be one-way: the load overwrote xl1:local-arm64 and the retag
# moved xl1:local, so ten seconds later there was no copy left of the image that
# had been producing fine. Recovery meant downloading an older release over the
# network at precisely the moment the node was already down.
#
# So every image update touches is also tagged with its own version, and the
# version being replaced is recorded. Rolling back is then a retag and a
# restart — seconds, no network, no rebuild.

PRODUCER_VERSION_LABEL=org.xyo.xl1-cli.version
ROLLBACK_FILE="${STATE_DIR}/rollback"
# Each kept version is a few hundred MB unpacked on an SD card, so the history
# is bounded. Shared layers mean the real cost is well under that.
KEEP_VERSIONS="${XL1_KEEP_VERSIONS:-3}"

# Which xl1-cli does this image carry? The label build-images.sh stamps answers
# instantly; the fallback starts a container, which costs about ten seconds on a
# Pi 3 and is only needed for images built before the label existed.
image_version() {
  local ref="$1" v
  docker image inspect "${ref}" >/dev/null 2>&1 || return 1
  v="$(docker image inspect -f "{{index .Config.Labels \"${PRODUCER_VERSION_LABEL}\"}}" "${ref}" 2>/dev/null)"
  if [[ -z "${v}" || "${v}" == "<no value>" ]]; then
    v="$(docker run --rm --entrypoint xl1 "${ref}" --version 2>/dev/null \
      | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n1)"
  fi
  [[ -n "${v}" ]] || return 1
  printf '%s' "${v}"
}

# Version-tagged producer images, newest first. Sorted -V, not lexically, so
# 5.10.0 does not rank below 5.9.0 the first time a minor reaches double digits.
producer_versions() {
  docker images xl1 --format '{{.Tag}}' 2>/dev/null \
    | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' | sort -Vr
}

# Keep the newest few, plus — regardless of age — whatever is running and
# whatever rollback points at. Removing a tag never removes an image that is
# still tagged something else, so this cannot delete xl1:local out from under a
# running producer.
prune_versions() {
  local keep_a="${1:-}" keep_b="${2:-}" n=0 v
  while read -r v; do
    [[ -z "${v}" ]] && continue
    n=$(( n + 1 ))
    (( n <= KEEP_VERSIONS )) && continue
    [[ "${v}" == "${keep_a}" || "${v}" == "${keep_b}" ]] && continue
    docker rmi "xl1:${v}" >/dev/null 2>&1 \
      && printf '  %spruned xl1:%s%s\n' "${DIM}" "${v}" "${RESET}"
  done < <(producer_versions)
}

read_rollback_target() {
  [[ -r "${ROLLBACK_FILE}" ]] || return 1
  local t; t="$(tr -d '[:space:]' < "${ROLLBACK_FILE}")"
  [[ -n "${t}" ]] || return 1
  printf '%s' "${t}"
}

# Restart the producer, including out of a failed state.
#
# `systemctl is-active` is false for a unit that FAILED, which is not the same
# thing as one an operator stopped -- and the difference cost a night. During an
# outage the producer crash-looped until systemd hit its restart limit and gave
# up; `update` then loaded the fixed image, found is-active false, skipped the
# restart entirely, and printed "services restarted". The node sat dead on a
# good image while the tool said it was fine.
#
# So: restart when the unit is running OR failed, and clear the failure counter
# first, because systemd refuses a start it considers repeated too quickly and
# the reset is the only thing that lifts it. A unit that is merely inactive was
# stopped on purpose and is left alone.
restart_producer_if_wanted() {
  local context="${1:-restart}"
  if systemctl is-failed --quiet xl1-producer; then
    printf '  %sproducer was in a failed state; clearing it before the restart%s\n' "${DIM}" "${RESET}"
    systemctl reset-failed xl1-producer 2>/dev/null || true
  elif ! systemctl is-active --quiet xl1-producer; then
    printf '  %sproducer was not running; started nothing%s\n' "${DIM}" "${RESET}"
    return 0
  fi
  systemctl restart xl1-producer || die "${context}"
}

# --------------------------------------------------------------------- status

cmd_status() {
  head_ "Services"
  for unit in xl1-producer xl1-dashboard xl1-collect.timer; do
    state="$(systemctl is-active "${unit}" 2>/dev/null || true)"
    enabled="$(systemctl is-enabled "${unit}" 2>/dev/null || echo '-')"
    case "${state}" in
      active) mark="${GREEN}●${RESET}" ;;
      inactive|failed) mark="${RED}●${RESET}" ;;
      *) mark="${YELLOW}●${RESET}" ;;
    esac
    printf '  %s %-22s %-10s %s%s%s\n' "${mark}" "${unit}" "${state:-unknown}" "${DIM}" "${enabled}" "${RESET}"
  done

  head_ "Container"
  if docker inspect xl1-producer >/dev/null 2>&1; then
    docker ps -a --filter name=xl1-producer \
      --format '  {{.Status}}   {{.Image}}' 2>/dev/null
  else
    row "xl1-producer" "not present"
  fi

  head_ "Chain"
  local port; port="$(dash_port)"
  local json; json="$(curl -sf --max-time 10 "http://127.0.0.1:${port}/api/status" 2>/dev/null || true)"
  if [[ -z "${json}" ]]; then
    row "dashboard API" "not responding on :${port}"
  elif command -v jq >/dev/null 2>&1; then
    printf '%s' "${json}" | jq -r '
      "  overall                \(.status)",
      "  current block          \(.chain.currentBlock // "—")",
      "  finalized              \(.chain.finalizedBlock // "—")",
      "  reward balance         \(.chain.balances.reward.xl1 // "—") XL1",
      "  signing balance        \(.chain.balances.producer.xl1 // "—") XL1",
      "  blocks won 24h         \(.derived.blocksByWindow.day24h // "—")",
      "  blocks won total       \(.peers.self.blocks // "—") (\(.peers.self.sharePercent // "—")% of \(.peers.scannedBlocks // "—") scanned)",
      (if (.problems | length) > 0 then "  problems               " + (.problems | join("; ")) else empty end)'
  else
    row "dashboard API" "responding (install jq for detail)"
  fi
  printf '\n'
}

# ------------------------------------------------------------ start and stop

cmd_start() {
  need_root start
  [[ -f "${PRODUCER_ENV}" ]] || die "${PRODUCER_ENV} not found — copy your env file there first"
  grep -qE '^XL1_MNEMONIC=.+$' "${PRODUCER_ENV}" || die "${PRODUCER_ENV} has no XL1_MNEMONIC set"
  systemctl enable --now xl1-collect.timer >/dev/null 2>&1
  systemctl enable --now xl1-dashboard >/dev/null 2>&1
  systemctl enable --now xl1-producer || die "producer failed to start — try: xl1ctl doctor"
  printf '%s✓%s producer, dashboard and collector started\n' "${GREEN}" "${RESET}"
  cmd_status
}

cmd_stop() {
  need_root stop
  systemctl stop xl1-producer 2>/dev/null
  printf '%s✓%s producer stopped (dashboard left running)\n' "${GREEN}" "${RESET}"
}

cmd_restart() {
  need_root restart
  # Same reason as the update path: a restart of a unit systemd has given up on
  # fails with "Start request repeated too quickly" until the counter is reset.
  systemctl reset-failed xl1-producer 2>/dev/null || true
  systemctl restart xl1-producer || die "restart failed — try: xl1ctl doctor"
  printf '%s✓%s producer restarted\n' "${GREEN}" "${RESET}"
  sleep 3
  cmd_status
}

# ----------------------------------------------------------------- log tails

cmd_logs() {
  local follow="" lines=100
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -f|--follow) follow=1; shift ;;
      -n) lines="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  if docker inspect xl1-producer >/dev/null 2>&1; then
    # --timestamps here stays in docker's native UTC rather than being rewritten
    # to local as the dashboard panel does: a terminal has the width for it, and
    # the full stamp is what you paste into a bug report.
    if [[ -n "${follow}" ]]; then docker logs -f --timestamps --tail "${lines}" xl1-producer 2>&1
    else docker logs --timestamps --tail "${lines}" xl1-producer 2>&1; fi
  else
    if [[ -n "${follow}" ]]; then journalctl -u xl1-producer -f
    else journalctl -u xl1-producer -n "${lines}" --no-pager; fi
  fi
}

# -------------------------------------------------------------------- health

cmd_health() {
  head_ "Producer probe"
  for p in livez readyz healthz; do
    code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "http://127.0.0.1:9099/${p}" 2>/dev/null || echo 000)"
    [[ "${code}" == "200" ]] && mark="${GREEN}ok${RESET}" || mark="${RED}${code}${RESET}"
    printf '  /%-8s %b\n' "${p}" "${mark}"
  done
  head_ "Dashboard"
  local port; port="$(dash_port)"
  code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "http://127.0.0.1:${port}/healthz" 2>/dev/null || echo 000)"
  row "/healthz" "${code}"
  printf '\n'
}

# ---------------------------------------------------------------- addresses

# The gap this closes: nothing in the running node ever prints which key it
# signs with. Without this you cannot tell "not yet allowlisted" from "wrong
# seed in the env file" — and both look like a perfectly healthy node.
cmd_addr() {
  need_root addr
  [[ -f "${PRODUCER_ENV}" ]] || die "${PRODUCER_ENV} not found"
  docker image inspect "${DASH_IMAGE}" >/dev/null 2>&1 \
    || die "${DASH_IMAGE} not loaded — run: xl1ctl update"

  local reward
  reward="$(grep -oP '^XL1_REWARD_ADDRESS=\K.*' "${PRODUCER_ENV}" 2>/dev/null | tr -d '"'"'"' ' | sed 's/^0[xX]//' | tr 'A-Z' 'a-z')"

  head_ "Addresses"

  # The mnemonic is passed via --env-file, never on the command line, so it
  # never lands in ps output or shell history.
  local derived
  derived="$(docker run --rm --env-file "${PRODUCER_ENV}" -w /app \
      --entrypoint node "${DASH_IMAGE}" --input-type=module -e '
      const { generateXyoBaseWalletFromPhrase } = await import("@xyo-network/xl1-sdk/protocol-sdk")
      const w = await generateXyoBaseWalletFromPhrase(process.env.XL1_MNEMONIC)
      process.stdout.write((await w.derivePath("0")).address.toLowerCase())
    ' 2>/dev/null)"

  if [[ -z "${derived}" ]]; then
    printf '  %scould not derive the signing address%s\n\n' "${RED}" "${RESET}"
    return 1
  fi

  row "signing (accountPath 0)" "${derived}"
  row "reward address" "${reward:-<unset>}"

  if [[ "${derived}" == "${reward}" ]]; then
    printf '\n  %s✓%s Signer and reward are the same address.\n' "${GREEN}" "${RESET}"
    printf '    If that address is allowlisted, blocks will be accepted.\n\n'
  else
    printf '\n  %s!%s Signer and reward differ.\n' "${YELLOW}" "${RESET}"
    printf '    Rewards still go to the reward address, but authorization depends\n'
    printf '    on the %ssigning%s address — that is the one that must be allowlisted.\n' "${BOLD}" "${RESET}"
    printf '    If you meant to sign as the reward address, put its seed in\n'
    printf '    %s instead.\n\n' "${PRODUCER_ENV}"
  fi
}

# ----------------------------------------------------------------- dashboard

cmd_dashboard() {
  local port ip ts
  port="$(dash_port)"
  ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
  head_ "Dashboard"
  row "LAN" "http://${ip}:${port}"
  row "mDNS" "http://$(hostname).local:${port}"
  if command -v tailscale >/dev/null 2>&1; then
    ts="$(tailscale ip -4 2>/dev/null | head -1)"
    [[ -n "${ts}" ]] && row "Tailscale" "http://${ts}:${port}"
  fi
  row "JSON" "http://${ip}:${port}/api/status"
  printf '\n'
}

# -------------------------------------------------------- backup and restore

cmd_backup() {
  need_root backup
  local out="${1:-${HOME:-/root}/xl1-backup-$(date +%Y%m%d-%H%M%S).tar.gz.enc}"
  [[ -d "${CONF_DIR}" ]] || die "${CONF_DIR} not found — nothing to back up"
  command -v openssl >/dev/null || die "openssl not installed"

  cat <<EOF

  This backs up ${CONF_DIR}, which contains ${BOLD}your producer seed phrase${RESET}.
  It is encrypted with a passphrase you choose now. If you lose that
  passphrase the backup is unrecoverable — there is no reset.

EOF
  # Restrictive mode BEFORE any bytes are written. openssl creates the file
  # itself, so a chmod placed after the pipeline never runs when the pipeline
  # reports failure — and this pipeline reports failure routinely: under
  # `pipefail`, tar exits 2 merely because .blocks-published does not exist yet,
  # which is the state of every Pi whose producer has not started. The result
  # was a complete, decryptable backup of the seed phrase left at 0644 while the
  # operator was told the backup had failed.
  local prev_umask; prev_umask="$(umask)"
  umask 077

  # Back up only what exists. The counter is a nice-to-have; the config is not.
  local members=(etc/xl1)
  [[ -f /var/lib/xl1/.blocks-published ]] && members+=(var/lib/xl1/.blocks-published)

  local ok=1
  tar -czf - -C / "${members[@]}" \
    | openssl enc -aes-256-cbc -pbkdf2 -iter 200000 -salt -out "${out}" \
    || ok=0
  umask "${prev_umask}"

  if (( ! ok )) || [[ ! -s "${out}" ]]; then
    # Never leave a partial archive of a seed phrase lying around.
    shred -u "${out}" 2>/dev/null || rm -f "${out}"
    die "backup failed — nothing was written"
  fi

  chmod 600 "${out}"
  printf '\n%s✓%s backup written to %s%s%s (%s)\n' "${GREEN}" "${RESET}" "${BOLD}" "${out}" "${RESET}" "$(du -h "${out}" | cut -f1)"
  printf '  Copy it somewhere off this Pi. An SD card is not a backup.\n\n'
}

cmd_restore() {
  need_root restore
  local in="${1:-}"
  [[ -n "${in}" ]] || die "usage: xl1ctl restore FILE"
  [[ -f "${in}" ]] || die "no such file: ${in}"
  command -v openssl >/dev/null || die "openssl not installed"

  printf '\n  This overwrites %s. Continue? [y/N] ' "${CONF_DIR}"
  read -r reply
  [[ "${reply}" =~ ^[Yy] ]] || { printf '  aborted\n\n'; return 1; }

  # Decrypt to a staging area first, so a wrong passphrase cannot leave
  # /etc/xl1 half-written.
  local tmp; tmp="$(mktemp -d)"
  trap 'rm -rf "${tmp}"' RETURN
  openssl enc -d -aes-256-cbc -pbkdf2 -iter 200000 -in "${in}" 2>/dev/null \
    | tar -xzf - -C "${tmp}" 2>/dev/null \
    || die "could not decrypt — wrong passphrase, or the file is corrupt. Nothing was changed."

  [[ -d "${tmp}/etc/xl1" ]] || die "archive does not contain etc/xl1. Nothing was changed."

  cp -a "${tmp}/etc/xl1/." "${CONF_DIR}/"
  chmod 600 "${PRODUCER_ENV}" 2>/dev/null
  [[ -f "${tmp}/var/lib/xl1/.blocks-published" ]] && \
    cp -a "${tmp}/var/lib/xl1/.blocks-published" "${STATE_DIR}/" 2>/dev/null

  printf '\n%s✓%s restored to %s\n' "${GREEN}" "${RESET}" "${CONF_DIR}"
  printf '  Start it with: sudo xl1ctl start\n\n'
}

# -------------------------------------------------------------------- update

# A local overlay at /etc/xl1/ui carries patches applied on top of the shipped
# dashboard image. Anything that retags xl1-dashboard:local from a tarball
# silently discards them — the image name is the same, so nothing looks wrong
# until a panel quietly reverts to an older build. Re-apply after every retag.
apply_ui_overlay() {
  local dir=/etc/xl1/ui
  [[ -f "${dir}/Dockerfile" ]] || return 0
  printf '  re-applying local dashboard overlay (%s)…\n' "${dir}"
  if docker build -q -t xl1-dashboard:local "${dir}" >/dev/null 2>&1; then
    printf '    overlay re-applied\n'
  else
    printf '    %swarning:%s overlay build failed — running the stock image\n' "${YELLOW}" "${RESET}"
  fi
}

# Fetching the tarballs by hand is the step that keeps going wrong: the bundle
# directory is root-owned, so a plain curl into it fails with a permission error
# and leaves the previous images in place — after which `update` cheerfully
# reloads exactly what was already running and reports success.
cmd_update() {
  need_root update

  if [[ "${1:-}" == "--release" ]]; then
    local tag="${2:-latest}" repo="${XL1_RELEASE_REPO:-LewSales/xl1-block-producer-pi}"
    local tmp; tmp="$(mktemp -d)"
    trap 'rm -rf "${tmp}"' RETURN

    local base="https://github.com/${repo}/releases"
    [[ "${tag}" == "latest" ]] && base="${base}/latest/download" || base="${base}/download/${tag}"

    printf '  fetching %s from %s…\n' "${tag}" "${repo}"
    for t in xl1-local-arm64 xl1-dashboard-arm64; do
      printf '    %s… ' "${t}.tar.gz"
      if curl -fsSL --retry 2 -o "${tmp}/${t}.tar.gz" "${base}/${t}.tar.gz"; then
        printf '%s\n' "$(du -h "${tmp}/${t}.tar.gz" | cut -f1)"
      else
        printf '%sfailed%s\n' "${RED}" "${RESET}"
        die "could not download ${t}.tar.gz from ${base}"
      fi
    done

    # A truncated download loads as a corrupt image, so check before touching
    # anything that is currently working.
    if curl -fsSL -o "${tmp}/SHA256SUMS" "${base}/SHA256SUMS" 2>/dev/null; then
      if (cd "${tmp}" && sha256sum -c SHA256SUMS >/dev/null 2>&1); then
        printf '  checksums verified\n'
      else
        die "checksum mismatch — refusing to load. Re-run, or download by hand and inspect."
      fi
    else
      printf '  %sno SHA256SUMS published for %s; skipping verification%s\n' "${DIM}" "${tag}" "${RESET}"
    fi

    set -- "${tmp}"
  fi

  local dir="${1:-}"
  if [[ -z "${dir}" ]]; then
    for c in "${HOME:-/root}/xl1-pi" /boot/firmware/xl1-pi /opt/xl1-pi "$(pwd)"; do
      [[ -f "${c}/xl1-local-arm64.tar.gz" ]] && { dir="${c}"; break; }
    done
  fi
  [[ -n "${dir}" ]] || die "could not find the image tarballs.
    Download them:  xl1ctl update --release
    Or point at a bundle:  xl1ctl update /path/to/xl1-pi"

  # Name the outgoing image before the load and retag below make it anonymous.
  # xl1:local still points at it right now; after the retag, nothing does.
  local prev_ver=""
  if prev_ver="$(image_version xl1:local)"; then
    docker tag xl1:local "xl1:${prev_ver}" >/dev/null 2>&1 \
      && printf '  keeping the running image as %sxl1:%s%s in case this goes badly\n' \
           "${BOLD}" "${prev_ver}" "${RESET}"
  else
    prev_ver=""
    printf '  %sno existing xl1:local to keep — nothing to roll back to after this%s\n' \
      "${DIM}" "${RESET}"
  fi

  # Every step below used to discard its status and fall through to an
  # unconditional success line, so a corrupt tarball, a full card, or a tag that
  # did not match reported "✓ images reloaded" while the old image kept running.
  # An operator was twice told an upgrade had landed when nothing had changed.
  local loaded=0 failed=0
  for t in xl1-local-arm64 xl1-dashboard-arm64; do
    [[ -f "${dir}/${t}.tar.gz" ]] || { printf '  %sskipping%s %s (not present)\n' "${DIM}" "${RESET}" "${t}"; continue; }
    printf '  loading %s…\n' "${t}"
    if gunzip -c "${dir}/${t}.tar.gz" | docker load | sed 's/^/    /'; then
      loaded=$(( loaded + 1 ))
    else
      printf '    %sfailed to load %s%s\n' "${RED}" "${t}" "${RESET}"
      failed=$(( failed + 1 ))
    fi
  done

  (( failed )) && die "${failed} image(s) failed to load — nothing was restarted, the previous images are still running"
  (( loaded )) || die "no image tarballs found in ${dir}"

  local retagged=0
  for pair in "xl1:local-arm64 xl1:local" "xl1-dashboard:local-arm64 xl1-dashboard:local"; do
    set -- ${pair}
    if docker image inspect "$1" >/dev/null 2>&1; then
      docker tag "$1" "$2" && retagged=$(( retagged + 1 ))
    else
      printf '  %swarning:%s %s not present after load — %s left pointing at the old image\n' \
        "${YELLOW}" "${RESET}" "$1" "$2"
    fi
  done

  # Tag what just landed, so the *next* update has a named thing to fall back
  # to and `xl1ctl versions` can list what this Pi actually holds.
  local new_ver=""
  new_ver="$(image_version xl1:local)" || new_ver=""
  [[ -n "${new_ver}" ]] && docker tag xl1:local "xl1:${new_ver}" >/dev/null 2>&1

  # Only record a target when the update changed something. Re-running update on
  # the version already installed must not leave rollback pointing at itself —
  # that would turn the recovery path into a no-op at the worst moment.
  if [[ -n "${prev_ver}" && "${prev_ver}" != "${new_ver}" ]]; then
    mkdir -p "${STATE_DIR}"
    printf '%s\n' "${prev_ver}" > "${ROLLBACK_FILE}"
  fi

  prune_versions "${new_ver}" "${prev_ver}"

  apply_ui_overlay

  systemctl restart xl1-dashboard || printf '  %swarning:%s dashboard did not restart — check: journalctl -u xl1-dashboard -n 50\n' "${YELLOW}" "${RESET}"
  restart_producer_if_wanted "images loaded, but the producer did not restart — check: xl1ctl doctor"

  # Say what actually happened rather than asserting success. The version the
  # node now runs is the only claim worth making here.
  local now=""
  now="$(image_version xl1:local)" || now=""
  printf '\n%s✓%s %s image(s) loaded, %s retagged, services restarted\n' \
    "${GREEN}" "${RESET}" "${loaded}" "${retagged}"
  [[ -n "${now}" ]] && printf '  xl1-cli now: %s%s%s\n' "${BOLD}" "${now}" "${RESET}"
  if [[ -n "${prev_ver}" && "${prev_ver}" != "${new_ver}" ]]; then
    printf '  if this one misbehaves: %ssudo xl1ctl rollback%s (back to %s)\n' \
      "${BOLD}" "${RESET}" "${prev_ver}"
  fi
  printf '\n'
}

# ------------------------------------------------------------------ rollback

cmd_rollback() {
  need_root rollback

  local target="${1:-}"
  if [[ -z "${target}" ]]; then
    target="$(read_rollback_target)" || die "no recorded rollback target.
    One is recorded by the update that replaces an image. Choose by hand:
      xl1ctl versions
      sudo xl1ctl rollback 5.3.0"
  fi

  docker image inspect "xl1:${target}" >/dev/null 2>&1 || die "xl1:${target} is not on this Pi.
    Here: $(producer_versions | tr '\n' ' ' | sed 's/ *$//')
    Or fetch it:  sudo xl1ctl update --release <release-tag>"

  local current=""; current="$(image_version xl1:local)" || current=""
  if [[ -n "${current}" && "${current}" == "${target}" ]]; then
    printf '\n%s✓%s already running %s — nothing to do\n\n' "${GREEN}" "${RESET}" "${target}"
    return 0
  fi

  printf '  %s → %s\n' "${current:-unknown}" "${target}"
  docker tag "xl1:${target}" xl1:local \
    || die "could not retag xl1:local — nothing was stopped, the node is still on ${current:-the old image}"

  # Swap rather than clear: the version just left is the obvious thing to roll
  # forward to, so a second rollback returns you to where you started. That is
  # what someone bisecting a bad release expects, and it means a mistaken
  # rollback is itself one command to undo.
  if [[ -n "${current}" ]]; then
    mkdir -p "${STATE_DIR}"
    printf '%s\n' "${current}" > "${ROLLBACK_FILE}"
  fi

  restart_producer_if_wanted "xl1:local now points at ${target}, but the producer did not restart — check: xl1ctl doctor"

  # The image answers for itself, the same way update does. A rollback that
  # reported success while the tag had not moved would be the worst outcome
  # here, because it is believed at the moment nobody wants to look further.
  local now=""; now="$(image_version xl1:local)" || now=""
  printf '\n%s✓%s producer image is now %s%s%s\n' \
    "${GREEN}" "${RESET}" "${BOLD}" "${now:-${target}}" "${RESET}"
  printf '  Confirm it produces again:  xl1ctl status\n\n'
}

# ------------------------------------------------------------------ versions

cmd_versions() {
  head_ "Producer images on this Pi"

  local current=""; current="$(image_version xl1:local)" || current=""
  local target=""; target="$(read_rollback_target)" || target=""

  local any=0 v mark note
  while read -r v; do
    [[ -z "${v}" ]] && continue
    any=1
    mark=' '; note=""
    if [[ "${v}" == "${current}" ]]; then mark="${GREEN}●${RESET}"; note="running now"
    elif [[ "${v}" == "${target}" ]]; then note="rollback target"
    fi
    printf '  %s %-12s %s%s%s\n' "${mark}" "${v}" "${DIM}" "${note}" "${RESET}"
  done < <(producer_versions)

  if (( ! any )); then
    printf '  %snone tagged yet — the next update starts recording them%s\n' "${DIM}" "${RESET}"
  fi

  printf '\n'
  if [[ -n "${target}" && "${target}" != "${current}" ]]; then
    printf '  Roll back:  %ssudo xl1ctl rollback%s\n\n' "${BOLD}" "${RESET}"
  fi
}

# -------------------------------------------------------------------- doctor

cmd_doctor() {
  head_ "Diagnosis"
  local issues=0

  if ! systemctl is-active --quiet xl1-producer; then
    printf '  %s✗%s producer not running\n' "${RED}" "${RESET}"
    issues=$((issues+1))
    if [[ ! -f "${PRODUCER_ENV}" ]]; then
      printf '    → %s is missing. Copy your env file there.\n' "${PRODUCER_ENV}"
    elif ! grep -qE '^XL1_MNEMONIC=.+$' "${PRODUCER_ENV}"; then
      printf '    → XL1_MNEMONIC is empty in %s.\n' "${PRODUCER_ENV}"
    else
      printf '    → last failure:\n'
      journalctl -u xl1-producer -n 12 --no-pager -p err 2>/dev/null | sed 's/^/      /'
      printf '    → full log: xl1ctl logs -n 60\n'
    fi
  else
    printf '  %s✓%s producer running\n' "${GREEN}" "${RESET}"
  fi

  if ! docker image inspect xl1:local >/dev/null 2>&1; then
    printf '  %s✗%s image xl1:local missing → xl1ctl update\n' "${RED}" "${RESET}"; issues=$((issues+1))
  fi

  local rc; rc="$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 -X POST \
    https://beta.api.chain.xyo.network/rpc -H 'content-type: application/json' --data '{}' 2>/dev/null || echo 000)"
  if [[ "${rc}" == "000" ]]; then
    printf '  %s✗%s cannot reach the Sequence gateway\n' "${RED}" "${RESET}"; issues=$((issues+1))
  else
    printf '  %s✓%s Sequence gateway reachable\n' "${GREEN}" "${RESET}"
  fi

  local swap_used
  swap_used="$(awk '/^SwapTotal:/{t=$2}/^SwapFree:/{f=$2}END{if(t>0)print int((t-f)*100/t); else print 0}' /proc/meminfo)"
  if (( swap_used > 60 )); then
    printf '  %s!%s swap %s%% used — memory pressure; consider lowering --max-old-space-size\n' "${YELLOW}" "${RESET}" "${swap_used}"
  fi

  if [[ -r /sys/devices/platform/soc/soc:firmware/get_throttled ]]; then
    local b; b=$(( $(cat /sys/devices/platform/soc/soc:firmware/get_throttled) ))
    (( (b >> 0) & 1 )) && { printf '  %s✗%s undervoltage right now — replace the power supply\n' "${RED}" "${RESET}"; issues=$((issues+1)); }
  fi

  printf '\n'
  if (( issues == 0 )); then
    printf '  Nothing obviously wrong. If blocks are not being accepted, check\n'
    printf '  that the signing address is allowlisted:  %ssudo xl1ctl addr%s\n\n' "${BOLD}" "${RESET}"
  fi
}

usage() {
  cat <<EOF
${BOLD}xl1ctl${RESET} — operate the XL1 block producer

  ${BOLD}status${RESET}              what is running, chain position, balances
  ${BOLD}start${RESET} | ${BOLD}stop${RESET} | ${BOLD}restart${RESET}
  ${BOLD}logs${RESET} [-f] [-n N]    producer logs
  ${BOLD}health${RESET}              raw probes
  ${BOLD}addr${RESET}                which address the node actually signs as
  ${BOLD}dashboard${RESET}           dashboard URLs
  ${BOLD}backup${RESET} [FILE]       encrypted backup of /etc/xl1 (holds the seed)
  ${BOLD}restore${RESET} FILE        restore from a backup
  ${BOLD}update${RESET} --release [TAG]
                        download that release (default latest), verify, reload
  ${BOLD}update${RESET} [DIR]        reload images from tarballs already on disk
  ${BOLD}versions${RESET}            producer images kept here, and which is running
  ${BOLD}rollback${RESET} [VERSION]  retag xl1:local to the previous image and restart
                        (no argument = the version the last update replaced)
  ${BOLD}doctor${RESET}              diagnose a producer that is not working

EOF
}

case "${1:-status}" in
  status)    shift; cmd_status "$@" ;;
  start)     shift; cmd_start "$@" ;;
  stop)      shift; cmd_stop "$@" ;;
  restart)   shift; cmd_restart "$@" ;;
  logs)      shift; cmd_logs "$@" ;;
  health)    shift; cmd_health "$@" ;;
  addr|address|whoami) shift; cmd_addr "$@" ;;
  dashboard|dash) shift; cmd_dashboard "$@" ;;
  backup)    shift; cmd_backup "$@" ;;
  restore)   shift; cmd_restore "$@" ;;
  update)    shift; cmd_update "$@" ;;
  versions|images) shift; cmd_versions "$@" ;;
  rollback)  shift; cmd_rollback "$@" ;;
  doctor)    shift; cmd_doctor "$@" ;;
  -h|--help|help) usage ;;
  *) printf '%sunknown command:%s %s\n\n' "${RED}" "${RESET}" "$1"; usage; exit 1 ;;
esac
