# Build artifacts — each exceeds GitHub's 100 MB file limit.
# Reproduce with ./build-images.sh
*.tar.gz
.build/
SHA256SUMS*
dashboard/node_modules/

# Real operator config. Only the .template files belong in git.
#
# Matched by shape, not by name. The named list missed producer.env and
# sequence-api.env — both holding a mnemonic — because a list can only cover the
# files that existed when it was written, and the next one is always the one
# nobody remembers to add.
*.env
!*.env.template

# Operator's own launcher settings: their Pi's address and login.
windows/_config.cmd

# OS noise
.DS_Store
Thumbs.db
