#!/usr/bin/env bash
# xl1-screen — full-screen console dashboard for a directly attached display.
#
# Draws to whatever TTY it is started on, so it works on the HDMI framebuffer or
# on a GPIO SPI panel once the console is mapped there. No X, no browser: on a
# 1 GB Pi that is also producing blocks, Chromium would cost more memory than the
# producer itself.
#
# Reads the same /api/status the web dashboard serves, so the two never disagree.
#
#   xl1-screen              # run until Ctrl-C
#   xl1-screen --once       # render a single frame and exit (for testing)
#   XL1_SCREEN_INTERVAL=10 xl1-screen

set -uo pipefail

API="${XL1_SCREEN_API:-http://127.0.0.1:8088/api/status}"
INTERVAL="${XL1_SCREEN_INTERVAL:-5}"
# Written by xl1-touch. Absent when nothing is driving touch, in which case the
# panel behaves exactly as it did before touch existed: page 0, forever.
PAGE_FILE="${XL1_SCREEN_PAGE_FILE:-/run/xl1-screen/page}"
PAGES=6
PAGE=0
ONCE=0
[[ "${1:-}" == "--once" ]] && ONCE=1

# 480x320 at an 8x16 console font is 60x20 cells, so that is the floor the
# layout has to survive. Wider terminals just get more breathing room.
MINW=52

esc=$'\033'
R="${esc}[0m"; B="${esc}[1m"; D="${esc}[2m"
FG_G="${esc}[32m"; FG_Y="${esc}[33m"; FG_R="${esc}[31m"
FG_C="${esc}[36m"; FG_W="${esc}[97m"; FG_GR="${esc}[90m"
ON_G="${esc}[42m${esc}[30m"; ON_Y="${esc}[43m${esc}[30m"; ON_R="${esc}[41m${esc}[97m"

cleanup() { printf '%s[?25h%s[0m\n' "${esc}" "${esc}"; }
trap cleanup EXIT INT TERM

have_jq=0; command -v jq >/dev/null 2>&1 && have_jq=1

# Commas every three digits, without relying on locale being set on a console.
group() { printf '%s' "${1:-}" | sed -e :a -e 's/\(.*[0-9]\)\([0-9]\{3\}\)/\1,\2/;ta'; }

pad() { printf '%-*s' "$2" "$1"; }

# Visible width, ignoring ANSI, so the right border lands in the right column.
#
# Pure bash on purpose. This runs for every line of every frame, and the old
# sed | wc | tr was three processes a line — roughly sixty forks per redraw, on
# the one box where spare CPU is exactly what block production is short of.
# Character counting follows the locale here the same way `wc -m` did, so the
# borders line up identically.
vislen() {
  local s="$1" pre rest
  while [[ "${s}" == *"${esc}["* ]]; do
    pre="${s%%"${esc}["*}"; rest="${s#*"${esc}["}"
    s="${pre}${rest#*m}"
  done
  printf '%s' "${#s}"
}

# ------------------------------------------------------------------ graphics
#
# The console font is Terminus, which carries the full Block Elements range, so
# these render on the panel rather than turning into replacement boxes. Every
# other glyph on this screen is already box-drawing or geometric shapes.

SPARK_GLYPH=(▁ ▂ ▃ ▄ ▅ ▆ ▇ █)

# A filled proportion bar. Cheaper and easier to read at a glance than a number,
# which is the whole point of a panel you walk past rather than sit at.
meter() {  # meter <percent> <width> [colour]
  local pct="${1:-0}" w="${2:-10}" col="${3:-}" filled i out=""
  pct="${pct%%.*}"
  [[ "${pct}" =~ ^[0-9]+$ ]] || pct=0
  (( pct > 100 )) && pct=100
  filled=$(( pct * w / 100 ))
  # Round a non-zero value up to one block. Otherwise a producer that landed
  # blocks draws exactly the same empty bar as one that landed none, and 1% swap
  # reads as no swap at all — the two states have to look different.
  (( filled == 0 && pct > 0 )) && filled=1
  for (( i = 0; i < w; i++ )); do
    (( i < filled )) && out+="█" || out+="░"
  done
  printf '%s%s%s' "${col}" "${out}" "${R}"
}

# One awk call scales the whole series; the glyph lookup is an array index, so
# this costs a single fork no matter how many points it draws. Values may be
# temperatures, percentages or six-digit block heights, hence the rescale to the
# observed range rather than to any fixed ceiling.
sparkline() {  # sparkline <space-separated values> [max points]
  local raw="${1:-}" want="${2:-40}" idx out=""
  [[ -z "${raw// /}" ]] && return 0
  for idx in $(awk -v s="${raw}" -v w="${want}" 'BEGIN{
      n = split(s, a, " ");
      if (n == 0) exit;
      start = (n > w) ? n - w + 1 : 1;
      lo = a[start]; hi = a[start];
      for (i = start; i <= n; i++) { if (a[i] < lo) lo = a[i]; if (a[i] > hi) hi = a[i] }
      rng = hi - lo;
      # A flat series is a real reading, not an error. Draw it as a flat low
      # line rather than as nothing, so "steady" and "no data" stay different.
      for (i = start; i <= n; i++)
        printf "%d ", (rng == 0) ? 0 : int((a[i] - lo) / rng * 7 + 0.5)
    }' 2>/dev/null); do
    out+="${SPARK_GLYPH[${idx}]}"
  done
  printf '%s' "${out}"
}

line() {  # line <content-with-ansi>
  local content="$1" vis
  vis=$(vislen "${content}")
  printf ' %s%s%s\n' "${content}" "$(printf '%*s' $(( W - vis > 0 ? W - vis : 0 ))'' )" ""
}

rule() { printf ' %s%s%s\n' "${FG_GR}" "$(printf '─%.0s' $(seq 1 "${W}"))" "${R}"; }

# Fetch and draw are separate so that changing page redraws from what is already
# in hand. Re-polling the API on every tap would make the panel feel slower the
# more you touch it, which is the opposite of the point.
# ---------------------------------------------------------------- pages
#
# Each draws its own body under the shared header. They exist because the panel
# previously showed one truncated log line and reading any further back meant
# finding a laptop.

page_log() {  # page_log <rows>
  local rows="$1" n
  # Leave room for header, rule and the footer hint.
  n=$(( rows - 5 )); (( n < 4 )) && n=4
  line "  ${B}PRODUCER LOG${R} ${D}newest first · ${LOGN:-0} held${R}"
  rule
  if (( have_jq )) && [[ -n "${JSON:-}" ]]; then
    printf '%s' "${JSON}" | jq -r --argjson n "${n}" \
      '.node.recentLog // [] | reverse | .[0:$n] | .[]' 2>/dev/null \
      | while IFS= read -r l; do line "  ${FG_GR}${l:0:$(( W - 3 ))}${R}"; done
  else
    line "  ${D}${LASTLOG:0:$(( W - 4 ))}${R}"
  fi
}

# The standings the dashboard grew: who else is producing, and where we sit.
# The panel is the thing actually visible in the room, so the comparison people
# care about belongs here and not only in a browser tab nobody has open.
page_peers() {  # page_peers <rows>
  local rows="$1" n
  n=$(( rows - 6 )); (( n < 3 )) && n=3
  line "  ${B}PRODUCER STANDINGS${R} ${D}${PEERN:-?} producers · ${PEERB:-?} blocks${R}"
  rule
  if (( have_jq )) && [[ -n "${JSON:-}" ]]; then
    local any=0
    while IFS=$'\t' read -r rank name blocks share self; do
      [[ -z "${rank}" ]] && continue
      any=1
      local bar name_c
      # Share is a percentage of a small sample, so the bar is scaled to the
      # leader rather than to 100 — against a fixed 100 every row would be a
      # stub and the ranking would be impossible to read at a glance.
      bar="$(meter "$(awk -v a="${share}" -v b="${PEERMAX:-1}" 'BEGIN{printf "%d", (b>0)? a/b*100 : 0}')" 10 "${FG_GR}")"
      if [[ "${self}" == "1" ]]; then
        name_c="${B}${FG_W}${name}${R}"
        bar="$(meter "$(awk -v a="${share}" -v b="${PEERMAX:-1}" 'BEGIN{printf "%d", (b>0)? a/b*100 : 0}')" 10 "${FG_C}")"
      else
        name_c="${FG_GR}${name}${R}"
      fi
      line "  ${D}${rank}.${R} $(pad "${name_c}" 0)$(printf '%*s' $(( 16 - ${#name} > 0 ? 16 - ${#name} : 1 )) '')${bar} $(printf '%4s' "${blocks}") ${D}${share}%${R}"
    done < <(printf '%s' "${JSON}" | jq -r '
      (.peers.top // [])[] |
      [ (.rank|tostring),
        (.label // ((.address[0:8]) + "…")),
        (.blocks|tostring),
        ((.sharePercent // 0)|tostring),
        (if .isSelf then "1" else "0" end) ] | @tsv' 2>/dev/null | head -n "${n}")
    if (( ! any )); then
      line ""
      line "  ${D}no producers observed yet — the scan is still filling${R}"
    fi
  else
    line "  ${D}jq not installed; standings need it${R}"
  fi
  [[ -n "${PEERRANK}" ]] && { line ""; line "  ${D}this node ranks${R} ${B}${FG_W}#${PEERRANK}${R} ${D}of ${PEERN}${R}"; }
}

page_chain() {
  line "  ${B}CHAIN & REWARDS${R}"
  rule
  line "  ${D}HEIGHT${R}   ${B}${FG_W}$(group "${CUR}")${R}  ${D}final${R} $(group "${FIN}")  ${D}lag${R} ${LAG:-?}"
  line "  ${D}RATE${R}     ${SPB:-?}s/block  ${D}·${R} ${BPH:-?}/h chain"
  local sp; sp="$(sparkline "${HHEIGHT}" $(( W - 14 )))"
  [[ -n "${sp}" ]] && line "  ${D}TREND${R}    ${FG_C}${sp}${R}"
  line ""
  line "  ${D}REWARD${R}   ${B}${FG_G}${REW}${R} XL1"
  [[ -n "${RPD}" ]] && line "  ${D}PER DAY${R}  ~${RPD} XL1 ${D}extrapolated${R}"
  line "  ${D}SHARE${R}    ${SHARE:-0}% ${D}of chain blocks${R}"
  # What that balance is worth, immediately under the balance -- the same place
  # the web dashboard puts it, and the first thing anyone asks about a number of
  # tokens. On sequence the honest answer is nothing, and saying "$0.00" instead
  # would read as a broken feed rather than as the truth about a test token.
  if [[ -n "${PNOMKT}" ]]; then
    line "  ${D}WORTH${R}    ${FG_GR}nothing yet — test token, trades nowhere${R}"
    [[ -n "${PNOT}" ]] && line "  ${D}IF IT DID${R} ${PCUR} ${PNOT} ${D}a scale, not an amount${R}"
  elif [[ -n "${PNOT}" ]]; then
    line "  ${D}WORTH${R}    ${B}${FG_G}${PCUR} ${PNOT}${R}"
  fi
  if [[ -n "${PVAL}" ]]; then
    local pc="${FG_GR}" pa=""
    if [[ -n "${PCHG}" ]]; then
      case "${PCHG}" in -*) pc="${FG_R}"; pa="▼ ${PCHG#-}%" ;; *) pc="${FG_G}"; pa="▲ ${PCHG}%" ;; esac
    fi
    line "  ${D}PRICE${R}    ${PCUR} ${PVAL} ${pc}${pa}${R} ${D}${PID}${R}"
  fi
  line ""
  if [[ -n "${LASTBLK}" ]]; then
    line "  ${D}LAST${R}     block ${FG_W}#$(group "${LASTBLK}")${R} ${D}·${R} ${SINCEBLK:-?} blocks ago"
  else
    line "  ${D}LAST${R}     ${FG_Y}no block landed yet${R}"
  fi
  [[ -n "${ELIG}" ]] && line "  ${D}BLOCKED${R}  ${FG_Y}${ELIG:0:$(( W - 12 ))}${R}"
  [[ -n "${PADDR}" ]] && line "  ${D}SIGNS AS${R} ${FG_GR}${PADDR:0:16}…${R}"
}

# The chain as a whole, rather than this node's place in it -- the standings
# page already answers that. Everything here was added to the web dashboard and
# had nowhere to go on the panel.
page_network() {
  line "  ${B}NETWORK${R}"
  rule
  if [[ -z "${NAKA}" ]]; then
    line ""
    line "  ${D}Not enough of the chain observed yet.${R}"
    line "  ${D}This fills in as blocks are scanned.${R}"
    return
  fi
  # How many producers would have to agree to control the chain. 1 is capture;
  # anything near half the field is healthy. The number is the whole point of
  # the page, so it is the only thing on the screen at full brightness.
  local nc="${FG_G}"
  [[ "${NAKA}" -le 2 ]] 2>/dev/null && nc="${FG_R}" || { [[ "${NAKA}" -le 3 ]] 2>/dev/null && nc="${FG_Y}"; }
  line "  ${D}NAKAMOTO${R} ${B}${nc}${NAKA}${R} ${D}of ${NPROD} producers control a majority${R}"
  line ""
  line "  ${D}LEADER${R}   ${LEADSH}%   ${D}TOP 3${R} ${TOP3}%   ${D}even would be${R} ${EVENSH}%"
  [[ -n "${TOP3}" ]] && line "  ${D}         ${R}$(meter "${TOP3%%.*}" $(( W - 14 )) "${FG_Y}")"
  line ""
  if [[ -n "${BTMED}" ]]; then
    line "  ${D}BLOCK${R}    ${B}${FG_W}${BTMED}s${R} ${D}median${R}  ${BTP90}s ${D}p90${R}  ${BTMEAN}s ${D}mean${R}"
    local sp; sp="$(sparkline "${BTB}" $(( W - 14 )))"
    [[ -n "${sp}" ]] && line "  ${D}SPREAD${R}   ${FG_C}${sp}${R}"
    line "  ${D}         ${R}${D}fast${R}$(pad "" $(( W - 24 )))${D}slow${R}"
    line "  ${D}SAMPLES${R}  ${BTN} ${D}intervals over ${OBSD}d · $(group "${OBSB}") blocks${R}"
  else
    line "  ${D}BLOCK${R}    ${D}no interval samples yet${R}"
  fi
}

page_system() {
  line "  ${B}HOST${R}"
  rule
  # Amber/red track the headroom left, not the throttle itself: the soft limit
  # provision.sh asks for is 70 °C and the hard limit is 85 °C. An actual
  # clock-down is reported by the throttle flags below, not by this colour.
  local tc="${FG_G}"; [[ "${TEMP%%.*}" -ge 75 ]] 2>/dev/null && tc="${FG_Y}"
  [[ "${TEMP%%.*}" -ge 80 ]] 2>/dev/null && tc="${FG_R}"
  # Temperature has no fixed ceiling to fill a bar against, so it gets the trend
  # line instead — the shape is what says whether cooling is keeping up.
  line "  ${D}CPU${R}      ${tc}${TEMP:-?}°C${R}   ${D}load${R} ${LOAD:-?}"
  local sp; sp="$(sparkline "${HTEMP}" $(( W - 14 )))"
  [[ -n "${sp}" ]] && line "  ${D}TEMP${R}     ${tc}${sp}${R}"
  local mc="${FG_G}"; [[ "${MEM:-0}" -ge 85 ]] 2>/dev/null && mc="${FG_R}" || { [[ "${MEM:-0}" -ge 70 ]] 2>/dev/null && mc="${FG_Y}"; }
  local sc="${FG_G}"; [[ "${SWP:-0}" -ge 60 ]] 2>/dev/null && sc="${FG_R}" || { [[ "${SWP:-0}" -ge 30 ]] 2>/dev/null && sc="${FG_Y}"; }
  local dc="${FG_G}"; [[ "${DISK:-0}" -ge 90 ]] 2>/dev/null && dc="${FG_R}" || { [[ "${DISK:-0}" -ge 75 ]] 2>/dev/null && dc="${FG_Y}"; }
  line "  ${D}MEMORY${R}   $(meter "${MEM:-0}" 12 "${mc}") $(printf '%3s' "${MEM:-?}")%"
  line "  ${D}SWAP${R}     $(meter "${SWP:-0}" 12 "${sc}") $(printf '%3s' "${SWP:-?}")%"
  line "  ${D}DISK${R}     $(meter "${DISK:-0}" 12 "${dc}") $(printf '%3s' "${DISK:-?}")%"
  local pw
  case "${PWROK}" in
    true)  [[ "${UVEVER}" == "true" ]] && pw="${FG_Y}undervolted earlier${R}" || pw="${FG_G}stable${R}" ;;
    false) pw="${ON_R} UNDERVOLTAGE ${R}" ;;
    *)     pw="${D}unknown${R}" ;;
  esac
  [[ "${HOTNOW}" == "true" ]] && pw="${ON_Y} CLOCKED DOWN FOR HEAT ${R}"
  line "  ${D}POWER${R}    ${pw}"
  line "  ${D}UPTIME${R}   $(( UPS / 86400 ))d $(( UPS % 86400 / 3600 ))h"
  line ""
  line "  ${D}CONTAINER${R} ${CST:-?}  ${D}up${R} ${CUPT:-?}  ${D}restarts${R} ${RESTARTS:-0}"
  if [[ -n "${CLIV}" ]]; then
    if [[ -n "${CLIL}" && "${CLIV}" != "${CLIL}" ]]; then
      line "  ${D}xl1-cli${R}   ${FG_Y}${CLIV} → ${CLIL} available${R}"
    else
      line "  ${D}xl1-cli${R}   ${FG_G}${CLIV}${R}"
    fi
  fi
  [[ -n "${OSU}" ]] && line "  ${D}HOST PKGS${R} ${OSU} pending${OSS:+, ${FG_Y}${OSS} security${R}}"
}

OK=0
JSON=""
fetch() {
  local json
  json="$(curl -sf --max-time 4 "${API}" 2>/dev/null)" || { OK=0; return; }
  [[ -z "${json}" ]] && { OK=0; return; }
  OK=1
  JSON="${json}"
}

render() {
  local cols rows
  cols=$(tput cols 2>/dev/null || echo 60)
  rows=$(tput lines 2>/dev/null || echo 20)
  W=$(( cols - 2 )); (( W < MINW )) && W=${MINW}

  local json ok="${OK}"
  json="${JSON:-}"

  printf '%s[H%s[2J%s[?25l' "${esc}" "${esc}" "${esc}"

  if (( ok == 0 )); then
    line "${B}${FG_C}XL1 PRODUCER${R}  ${FG_GR}$(date '+%H:%M:%S')${R}"
    rule
    line ""
    line "  ${ON_R} DASHBOARD UNREACHABLE ${R}"
    line ""
    line "  ${D}No answer from${R} ${API}"
    line ""
    line "  ${D}Try:${R} systemctl status xl1-dashboard"
    line "  ${D}    ${R} xl1ctl doctor"
    return
  fi

  # Every variable gets a value before jq is asked for one. Previously a failed
  # jq left `eval ""` and the first use of ${HOST} aborted the whole script —
  # which is exactly what a panel is worst placed to recover from, since nobody
  # is watching a console for a stack trace.
  ST="unknown"; PROB=""; CUR=""; FIN=""; LAG=""; REW=""; DELTA=""; SUB=""; ERRS=""
  CST=""; HLIVE=false; TEMP=""; MEM=""; SWP=""; UPS=0; PWROK=unknown
  UVEVER=false; HOTNOW=false; HOST=""; NET=""; CHOK=false; LASTLOG=""
  LOGN=0; LASTBLK=""; SINCEBLK=""; SPB=""; BPH=""; SHARE=""; RPD=""; PADDR=""
  ELIG=""; CLIV=""; CLIL=""; OSU=""; OSS=""; DISK=""; LOAD=""; CUPT=""; RESTARTS=""
  HHEIGHT=""; HTEMP=""; PEERN=""; PEERB=""; PEERRANK=""; PEERMAX="1"
  NAKA=""; LEADSH=""; TOP3=""; EVENSH=""; NPROD=""; BTMED=""; BTP90=""
  BTMEAN=""; BTN=""; BTB=""; OBSD=""; OBSB=""
  PVAL=""; PCHG=""; PID=""; PCUR=""; PNOT=""; PNOMKT=""
  ALINST=""; ALRUN=""; ALFIRE=0; ALDEAD=""

  if (( have_jq )) && [[ -n "${json}" ]]; then
    eval "$(printf '%s' "${json}" | jq -r '
      @sh "ST=\(.status)",
      @sh "CUR=\(.chain.currentBlock // "")",
      @sh "FIN=\(.chain.finalizedBlock // "")",
      @sh "LAG=\(.chain.finalizationLag // "")",
      @sh "REW=\(.chain.balances.reward.xl1 // "")",
      @sh "DELTA=\(.chain.balances.reward.sinceStart.xl1 // "")",
      @sh "SUB=\(.node.blocksPublished // "")",
      @sh "ERRS=\(.node.errorCount // "")",
      @sh "CST=\(.node.container.state // "")",
      @sh "HLIVE=\(.health.ok)",
      @sh "TEMP=\(.system.cpuTempC // "")",
      @sh "MEM=\(.system.memory.usedPercent // "")",
      @sh "SWP=\(.system.swap.usedPercent // "")",
      @sh "UPS=\(.system.uptimeSeconds // 0)",
      # jq'"'"'s // fires on false as well as null, so a healthy:false throttle
      # would silently read as "unknown" — which is the one reading this panel
      # exists to shout about. Test for the object instead.
      @sh "PWROK=\(if .system.throttle == null then "unknown" else (.system.throttle.healthy | tostring) end)",
      @sh "UVEVER=\(if .system.throttle == null then "false" else (.system.throttle.undervoltageSinceBoot | tostring) end)",
      @sh "HOTNOW=\(if .system.throttle == null then "false" else (.system.throttle.softTempLimitNow | tostring) end)",
      @sh "HOST=\(.system.hostname // "")",
      @sh "NET=\(.chain.networkName // "")",
      @sh "CHOK=\(.chain.ok)",
      @sh "PROB=\(.problems | join(" | "))",
      @sh "LASTLOG=\(.node.recentLog[-1] // "")",
      @sh "LOGN=\(.node.recentLog | length)",
      @sh "LASTBLK=\(.derived.lastBlock // "")",
      @sh "SINCEBLK=\(.derived.blocksSinceLast // "")",
      @sh "SPB=\(.derived.secondsPerBlock // "")",
      @sh "BPH=\(.derived.blocksPerHourChain // "")",
      @sh "SHARE=\(.derived.sharePercent // "")",
      @sh "RPD=\(.derived.rewardPerDay // "")",
      @sh "PADDR=\(.chain.balances.producer.address // "")",
      @sh "ELIG=\(if .node.eligibility.blocked then (.node.eligibility.reason + (if .node.eligibilityIgnored then " (not enforced here)" else "" end)) else "" end)",
      @sh "CLIV=\(.release.installed // "")",
      @sh "CLIL=\(.release.latest // "")",
      @sh "OSU=\(.node.os.updates // "")",
      @sh "OSS=\(.node.os.securityUpdates // "")",
      @sh "DISK=\(.system.disk.usedPercent // "")",
      @sh "LOAD=\(.system.loadAverage[0] // "")",
      @sh "CUPT=\(.node.container.uptime // "")",
      @sh "RESTARTS=\(.node.container.restartCount // "")",
      # The trend arrays used to be [{t,v},...] and are now plain numbers -- the
      # payload was slimmed and this line was not. Indexing a number with .v is
      # a hard error in jq, and a hard error abandons the REST OF THE PROGRAM:
      # every field below this point came back empty, which silently emptied the
      # standings page and both sparklines. Accept either shape so the panel
      # survives a dashboard that is older or newer than itself.
      @sh "HHEIGHT=\([.history.height[]? | if type == "object" then .v else . end] | join(" "))",
      @sh "HTEMP=\([.history.tempC[]? | if type == "object" then .v else . end] | join(" "))",
      @sh "PEERN=\(.peers.producers // "")",
      @sh "PEERB=\(.peers.scannedBlocks // "")",
      @sh "PEERRANK=\(.peers.selfRank // "")",
      # The leader'"'"'s share, so the bars on the standings page scale to the
      # field instead of to an unreachable 100%.
      @sh "PEERMAX=\([.peers.top[]?.sharePercent] | max // 1)",
      # Everything below arrived with the network and price work and had no way
      # onto this panel, which on a headless Pi is the only view there is.
      @sh "NAKA=\(.network.concentration.nakamoto // "")",
      @sh "LEADSH=\(.network.concentration.leaderShare // "")",
      @sh "TOP3=\(.network.concentration.top3Share // "")",
      @sh "EVENSH=\(.network.concentration.evenShare // "")",
      @sh "NPROD=\(.network.concentration.producers // "")",
      @sh "BTMED=\(.network.blockTime.medianSeconds // "")",
      @sh "BTP90=\(.network.blockTime.p90Seconds // "")",
      @sh "BTMEAN=\(.network.blockTime.meanSeconds // "")",
      @sh "BTN=\(.network.blockTime.samples // "")",
      @sh "BTB=\([.network.blockTime.buckets[]?] | join(" "))",
      @sh "OBSD=\(.network.observed.daysStored // "")",
      @sh "OBSB=\(.network.observed.blocks // "")",
      @sh "PVAL=\(.price.value // "")",
      @sh "PCHG=\(.price.change24h // "")",
      @sh "PID=\(.price.id // "")",
      @sh "PCUR=\(.price.currency // "" | ascii_upcase)",
      @sh "PNOT=\(.price.notional // "")",
      @sh "PNOMKT=\(if .price.marketNote then "1" else "" end)",
      # Whether anything would say it stopped -- the one question this panel
      # cannot answer for itself, because a dead Pi draws no frame at all.
      @sh "ALINST=\(if .alerts.installed then "1" else "" end)",
      @sh "ALRUN=\(if .alerts.running then "1" else "" end)",
      @sh "ALFIRE=\(.alerts.active | length)",
      @sh "ALDEAD=\(if .alerts.armed.deadman then "1" else "" end)"
    ' 2>/dev/null)"
  elif (( ! have_jq )); then
    PROB="jq not installed"
  fi

  # A jq that ran but produced nothing leaves ST at its default. Say so on the
  # panel rather than drawing a frame full of dashes.
  [[ "${ST}" == "unknown" && -n "${json}" ]] && PROB="${PROB:-could not parse the status document}"

  # --- header -------------------------------------------------------------
  local title="${B}${FG_C}XL1 PRODUCER${R}"
  [[ -n "${HOST}" ]] && title+=" ${FG_GR}${HOST}${R}"
  [[ -n "${NET}" ]] && title+=" ${D}·${R} ${FG_W}${NET}${R}"
  # Dots rather than "2/4": at this size the reader wants to know there is more,
  # not to do arithmetic.
  local dots=""
  if [[ -e "${PAGE_FILE}" ]]; then
    local i
    for (( i = 0; i < PAGES; i++ )); do
      (( i == PAGE )) && dots+="${FG_W}●${R}" || dots+="${FG_GR}·${R}"
    done
    dots+=" "
  fi
  # A frozen panel and a healthy one look identical when every number happens to
  # be unchanged. This dot alternates on each redraw, so "is it still running"
  # is answerable from across the room without reading anything.
  FRAME=$(( (${FRAME:-0} + 1) % 2 ))
  local beat; (( FRAME )) && beat="${FG_W}●${R}" || beat="${FG_GR}●${R}"
  local clock="${dots}${beat} ${FG_GR}$(date '+%H:%M:%S')${R}"
  local tlen; tlen=$(vislen "${title}${clock}")
  printf ' %s%*s%s\n' "${title}" $(( W - tlen > 0 ? W - tlen : 1 )) "" "${clock}"
  rule

  # Pages 1-3 draw their own body and return; page 0 is the overview below,
  # unchanged from what this panel showed before touch existed.
  case "${PAGE}" in
    1) page_log "${rows}"; return ;;
    2) page_chain; return ;;
    3) page_system; return ;;
    4) page_peers "${rows}"; return ;;
    5) page_network; return ;;
  esac

  # --- status banner ------------------------------------------------------
  case "${ST}" in
    ok)       line "  ${ON_G} HEALTHY ${R}   ${D}producing${R}" ;;
    degraded) line "  ${ON_Y} DEGRADED ${R}  ${FG_Y}${PROB:0:$(( W - 14 ))}${R}" ;;
    down)     line "  ${ON_R} DOWN ${R}      ${FG_R}${PROB:0:$(( W - 14 ))}${R}" ;;
    *)        line "  ${ON_Y} ${ST} ${R}" ;;
  esac
  line ""

  # --- chain --------------------------------------------------------------
  if [[ "${CHOK}" == "true" ]]; then
    local lagc="${FG_G}"; [[ "${LAG:-0}" -gt 5 ]] 2>/dev/null && lagc="${FG_Y}"
    line "  ${D}BLOCK${R}   ${B}${FG_W}$(pad "$(group "${CUR}")" 12)${R} ${D}final${R} $(pad "$(group "${FIN}")" 10) ${lagc}lag ${LAG}${R}"
  else
    line "  ${D}BLOCK${R}   ${FG_R}chain unreachable${R}"
  fi

  [[ -n "${REW}" ]] && {
    local dl=""
    [[ -n "${DELTA}" && "${DELTA}" != "0.0000" ]] && dl=" ${FG_G}+${DELTA}${R}"
    line "  ${D}REWARD${R}  ${B}${FG_W}${REW}${R} ${D}XL1${R}${dl}"
  }

  line "  ${D}SUBMIT${R}  $(pad "${SUB:-—}" 12) ${D}errors${R} $( [[ "${ERRS:-0}" -gt 0 ]] 2>/dev/null && printf '%s' "${FG_Y}${ERRS}${R}" || printf '%s' "${ERRS:-0}" )"
  line ""

  # --- node + system ------------------------------------------------------
  local hs; [[ "${HLIVE}" == "true" ]] && hs="${FG_G}live${R}" || hs="${FG_R}not responding${R}"
  line "  ${D}NODE${R}    $(pad "${CST:-—}" 12) ${D}probe${R} ${hs}"

  local tc="${FG_G}"
  [[ -n "${TEMP}" ]] && { awk "BEGIN{exit !(${TEMP} >= 80)}" && tc="${FG_R}" || { awk "BEGIN{exit !(${TEMP} >= 75)}" && tc="${FG_Y}"; }; }
  local mc="${FG_G}"; [[ "${MEM:-0}" -ge 85 ]] 2>/dev/null && mc="${FG_R}" || { [[ "${MEM:-0}" -ge 70 ]] 2>/dev/null && mc="${FG_Y}"; }
  local sc="${FG_G}"; [[ "${SWP:-0}" -ge 60 ]] 2>/dev/null && sc="${FG_R}" || { [[ "${SWP:-0}" -ge 30 ]] 2>/dev/null && sc="${FG_Y}"; }

  local up="${UPS:-0}" upstr
  upstr="$(( up/86400 ))d $(( up%86400/3600 ))h"
  line "  ${D}CPU${R} ${tc}${TEMP:-—}°C${R}  ${D}RAM${R} ${mc}${MEM:-—}%${R}  ${D}SWAP${R} ${sc}${SWP:-—}%${R}  ${D}UP${R} ${upstr}"

  local pw
  case "${PWROK}" in
    true)  [[ "${UVEVER}" == "true" ]] && pw="${FG_Y}undervolted earlier${R}" || pw="${FG_G}stable${R}" ;;
    false) pw="${ON_R} UNDERVOLTAGE ${R}" ;;
    *)     pw="${D}unknown${R}" ;;
  esac
  [[ "${HOTNOW}" == "true" ]] && pw="${ON_Y} CLOCKED DOWN, HOT ${R}"
  line "  ${D}POWER${R}   ${pw}"

  # The one thing this panel can never tell you itself: a Pi that has stopped
  # draws no frame, so a frozen screen and a dead node look identical. Whether
  # something off-box is watching belongs here, where it is read every day.
  local al
  if [[ -z "${ALINST}" ]]; then al="${FG_Y}not set up${R}"
  elif [[ -z "${ALRUN}" ]]; then al="${ON_R} ALERTER STOPPED ${R}"
  elif [[ "${ALFIRE:-0}" -gt 0 ]] 2>/dev/null; then al="${ON_Y} ${ALFIRE} FIRING ${R}"
  else al="${FG_G}all clear${R}"; [[ -n "${ALDEAD}" ]] && al+=" ${D}· deadman armed${R}"
  fi
  line "  ${D}ALERTS${R}  ${al}"

  # --- log tail, if the screen is tall enough -----------------------------
  if (( rows >= 18 )) && [[ -n "${LASTLOG}" ]]; then
    line ""
    rule
    line "  ${FG_GR}${LASTLOG:0:$(( W - 4 ))}${R}"
  fi

  # This panel is the version people photograph and post. Say whose it is on the
  # screen itself, not only in a repo nobody following the photo will open.
  #
  # A 480x320 panel at 8x16 is exactly 20 rows, so anything gated above that
  # never appears on the display this was written for. Two variants so it still
  # fits when the log tail has taken the space.
  if (( rows >= 18 )); then
    line ""
    if [[ -e "${PAGE_FILE}" ]]; then
      line "  ${D}tap: next page · hold: back to overview${R}"
    fi
    # 51 columns including the indent, so it fits the 60 a 480x320 panel gives
    # and needs no shorter variant.
    if (( W >= 51 )); then
      line "  ${D}by LewSales · unofficial · not affiliated with XYO${R}"
    else
      line "  ${D}LewSales · not XYO${R}"
    fi
  fi
}

read_page() {
  local p
  p="$(cat "${PAGE_FILE}" 2>/dev/null || echo 0)"
  [[ "${p}" =~ ^[0-9]+$ ]] || p=0
  (( p >= PAGES )) && p=0
  printf '%s' "${p}"
}

if (( ONCE )); then
  PAGE="$(read_page)"
  fetch
  render
  printf '%s[?25h' "${esc}"
  exit 0
fi

# Two clocks. Data refreshes on INTERVAL; the page is checked ten times a second
# so a tap redraws immediately instead of whenever the next poll happens to land.
# A redraw from a page change costs nothing — the data is already in hand.
# Adopt the page that is already selected rather than assuming 0: the touch
# daemon's choice outlives a restart of this script, and treating it as a change
# used to trigger a render before anything had been fetched.
PAGE="$(read_page)"
fetch
render

LAST_FETCH=${SECONDS}
while true; do
  now=${SECONDS}
  if (( now - LAST_FETCH >= INTERVAL )); then
    fetch
    LAST_FETCH=${now}
    render
  fi

  for (( i = 0; i < INTERVAL * 10; i++ )); do
    sleep 0.1
    p="$(read_page)"
    if [[ "${p}" != "${PAGE}" ]]; then
      PAGE="${p}"
      render
    fi
    (( SECONDS - LAST_FETCH >= INTERVAL )) && break
  done
done
